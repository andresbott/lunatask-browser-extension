{
  "name": "lunatask-extension",
  "version": "0.4.0",
  "description": "Unofficial Lunatask browser companion for saving pages, links, and selections as tasks or notes.",
  "homepage": "https://github.com/andresbott/lunatask-browser-extension",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresbott/lunatask-browser-extension.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "build:firefox": "vite build --mode firefox",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/webextension-polyfill": "^0.10.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.9.4",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-web-extension": "^4.1.0",
    "webextension-polyfill": "^0.11.0"
  },
  "dependencies": {
    "@types/turndown": "^5.0.6",
    "defuddle": "^0.6.6",
    "turndown": "^7.2.2"
  }
}
